{
  "name": "axis",
  "productName": "Axis",
  "version": "0.3.1",
  "description": "A minimalistic, customizable, and beautiful browser built on Electron",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node scripts/patch-electron-mac-display-name.js",
    "i18n:sync": "node scripts/i18n-sync-offline.js",
    "prebuild": "npm run i18n:sync",
    "start": "node scripts/run-electron.js",
    "dev": "node scripts/run-electron.js --dev",
    "build": "npx electron-builder",
    "dist": "npx electron-builder --publish=never"
  },
  "overrides": {
    "ip-address": "^10.2.0",
    "fast-uri": "^3.1.7",
    "tar": "^7.5.21",
    "ajv": "^8.18.0",
    "@develar/schema-utils": {
      "ajv": "^6.12.6"
    },
    "minimatch": "^10.2.3",
    "brace-expansion": "^5.0.9",
    "picomatch": "4.0.4",
    "@xmldom/xmldom": "0.8.15",
    "file-type": ">=21.3.1",
    "tmp": "0.2.7",
    "form-data": "^4.0.6",
    "js-yaml": "^4.3.1",
    "app-builder-lib": "^26.15.7",
    "builder-util-runtime": "^9.7.0"
  },
  "keywords": [
    "browser",
    "electron",
    "minimalistic",
    "customizable"
  ],
  "author": "Axis Browser Team",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "electron": "41.10.6",
    "electron-builder": "^26.15.7",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.3",
    "picomatch": "4.0.4",
    "tar": "^7.5.21"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.14.1",
    "@primno/dpapi": "^2.0.1",
    "adm-zip": "^0.6.0",
    "dictionary-en": "^4.0.0",
    "electron-store": "^8.1.0",
    "jimp": "^1.6.1",
    "lz4js": "^0.2.0",
    "nspell": "^2.1.5",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.axis.browser",
    "productName": "Axis",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/dictionary-en/**",
      "**/*.node",
      "**/src/preload.js",
      "**/src/webview-preload*.js"
    ],
    "files": [
      "src/**/*",
      "scripts/suppress-stderr-patterns.js",
      "assets/**/*",
      "Axis_logo.png",
      "package.json",
      "!**/*.map",
      "!**/node_modules/@types/**",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/**/{test,tests,__tests__,docs}/**"
    ],
    "icon": "Axis_logo.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/Axis.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          },
          {
            "CFBundleTypeName": "URL",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.url"
            ]
          }
        ]
      }
    },
    "protocols": [
      {
        "name": "Axis HTTP Link",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "shtml",
          "xhtml"
        ],
        "name": "HTML Document",
        "role": "Viewer",
        "rank": "Default"
      }
    ],
    "dmg": {
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
